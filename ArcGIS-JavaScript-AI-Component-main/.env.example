# ArcGIS OAuth Client ID (required)
VITE_ARCGIS_OAUTH_APP_ID=your-arcgis-oauth-app-id

# Optional: ArcGIS portal URL (defaults to https://www.arcgis.com)
VITE_ARCGIS_PORTAL_URL=https://www.arcgis.com

# Optional: app title shown in browser and assistant heading
VITE_APP_NAME=ArcGIS Assistant Demo

# Optional: TA5500 RAG API key (same value as RAG_API_KEY of the ta5500-rag stack).
# Read by the MCP hub (npm run hub), not by the browser app, so it has no VITE_ prefix.
RAG_API_KEY=

# Optional: web map item id loaded on sign-in when no last map is stored
VITE_DEFAULT_WEBMAP_ID=
